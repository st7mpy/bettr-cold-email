# Database (Supabase)
# DATABASE_URL is the pooled "transaction mode" connection (used by app at runtime).
# DIRECT_URL is the direct connection (used for migrations).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# Public app URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Google OAuth (Phase 2)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Token encryption (32 random bytes, base64).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Anthropic (Phase 3+)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_OPUS_MODEL=claude-opus-4-7
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5

# Tavily (Phase 3+)
TAVILY_API_KEY=tvly-xxx

# Inngest (Phase 3+; optional for local dev — `inngest-cli dev` works keyless)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
